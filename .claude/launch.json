{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "apps/web",
        "--",
        "--port",
        "3000"
      ],
      "port": 3000
    },
    {
      "name": "sim",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "cd services/sim && exec .venv/bin/python -m uvicorn worldsim.api:app --host 127.0.0.1 --port 8731"
      ],
      "port": 8731,
      "autoPort": false
    }
  ]
}